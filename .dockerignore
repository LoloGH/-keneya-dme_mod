# Dépendances reconstruites dans l'image
/vendor
/node_modules

# Artefacts de build
/public/build
/public/hot
/public/storage

# Environnement et secrets — ne doivent jamais entrer dans une image
.env
.env.*
!.env.example

# Base de données locale
/database/*.sqlite
/database/*.sqlite-journal

# Données d'exécution
/storage/app/private/medical-documents
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/pail
/bootstrap/cache/*

# Développement
/.git
/.github
/.idea
/.vscode
/tests
/docs
.phpunit.result.cache
.phpunit.cache
*.md
!README.md
Dockerfile
docker-compose*.yml
.dockerignore
