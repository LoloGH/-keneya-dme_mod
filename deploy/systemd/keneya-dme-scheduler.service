# Planificateur Keneya-DME (suivi d'acheminement SMS, purges).
#
# Deux options : ce service, ou une entrée cron (voir docs/DEPLOIEMENT.md).
# Le service est préférable : il survit aux redémarrages et se journalise.
#
#   sudo cp deploy/systemd/keneya-dme-scheduler.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now keneya-dme-scheduler

[Unit]
Description=Keneya-DME — planificateur de tâches
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/keneya-dme

ExecStart=/usr/bin/php artisan schedule:work

Restart=always
RestartSec=5

PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=keneya-scheduler

[Install]
WantedBy=multi-user.target
