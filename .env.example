# ---------------------------------------------------------------------------
# Keneya-DME App — configuration d'exemple
# Copier vers .env puis exécuter : php artisan key:generate
# Aucune valeur secrète réelle ne doit être committée dans ce dépôt.
# ---------------------------------------------------------------------------
APP_NAME="Keneya-DME"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données — SQLite par défaut pour une prise en main immédiate.
# MySQL/PostgreSQL sont supportés sans changement de code.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=keneya_dme
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@keneya.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Établissement (affiché dans l'interface et sur les PDF)
# ---------------------------------------------------------------------------
KENEYA_FACILITY_NAME="Centre Hospitalier Keneya"
KENEYA_FACILITY_ADDRESS="Bamako, Mali"
KENEYA_FACILITY_PHONE="+223 20 00 00 00"
KENEYA_FACILITY_EMAIL="contact@keneya.test"

# ---------------------------------------------------------------------------
# Service SMS transversal
# drivers disponibles : log (par défaut, aucun envoi réel), array, http
# ---------------------------------------------------------------------------
SMS_DRIVER=log
SMS_SENDER="Keneya"
SMS_MAX_ATTEMPTS=3
SMS_RETRY_DELAY=60
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# Comptes de démonstration (environnement local uniquement).
# Le seeder refuse de s'exécuter hors environnement local/testing.
# Définissez un mot de passe ici : aucune valeur par défaut n'est codée en dur.
# ---------------------------------------------------------------------------
DEMO_SEED_ENABLED=true
DEMO_USER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
