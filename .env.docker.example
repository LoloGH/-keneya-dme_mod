# ---------------------------------------------------------------------------
# Keneya-DME — environnement Docker
#
#   cp .env.docker.example .env
#   docker compose up -d --build
#   → http://localhost:8080
#
# Générer APP_KEY :
#   docker compose run --rm app php artisan key:generate --show
# ---------------------------------------------------------------------------
APP_NAME="Keneya-DME"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Base de données — service « db » de la stack
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=keneya_dme
DB_USERNAME=keneya
# Obligatoires : la stack refuse de démarrer sans ces valeurs.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Migrations appliquées au démarrage du conteneur applicatif.
RUN_MIGRATIONS=true
# Données de démonstration — à laisser à false hors évaluation.
RUN_SEEDERS=false

# ---------------------------------------------------------------------------
# Sessions, cache et file d'attente
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# À passer à true dès que l'application est servie en HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Établissement
# ---------------------------------------------------------------------------
KENEYA_FACILITY_NAME="Centre Hospitalier Keneya"
KENEYA_FACILITY_ADDRESS="Bamako, Mali"
KENEYA_FACILITY_PHONE="+223 20 00 00 00"
KENEYA_FACILITY_EMAIL="contact@keneya.test"

# ---------------------------------------------------------------------------
# SMS — voir .env.example pour le détail des variables
# ---------------------------------------------------------------------------
SMS_GATEWAY=log
SMS_SENDER="Keneya"
SMS_COUNTRY_CODE="+223"

SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=

# ---------------------------------------------------------------------------
# Démonstration (RUN_SEEDERS=true et APP_ENV=local uniquement)
# ---------------------------------------------------------------------------
DEMO_SEED_ENABLED=false
DEMO_USER_PASSWORD=
